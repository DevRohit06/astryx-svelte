{
  "name": "astryx-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "A Svelte 5 port of Astryx, Meta's open source design system. Unofficial and not affiliated with Meta.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @astryx-svelte/core dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:root": "prettier --check port/*.md *.md",
    "format": "pnpm -r format",
    "check:publish": "node scripts/check-publish.mjs",
    "status": "node scripts/status.mjs",
    "status:full": "node scripts/status.mjs --full",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast"
  },
  "workspaces": [
    "packages/*",
    "packages/themes/*",
    "docs"
  ],
  "devDependencies": {
    "prettier": "^3.8.3",
    "publint": "^0.3.21"
  }
}
