{
	"name": "docs",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"generate": "node scripts/generate-content.mjs && node --experimental-strip-types scripts/build-astryx-theme.mjs",
		"emit-core-docs": "node scripts/emit-core-docs.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node scripts/emit-core-docs.mjs --check && node scripts/check-preview-theme.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@astryx-svelte/core": "workspace:*",
		"@astryx-svelte/theme-butter": "workspace:*",
		"@astryx-svelte/theme-chocolate": "workspace:*",
		"@astryx-svelte/theme-gothic": "workspace:*",
		"@astryx-svelte/theme-liquid-glass": "workspace:*",
		"@astryx-svelte/theme-matcha": "workspace:*",
		"@astryx-svelte/theme-neutral": "workspace:*",
		"@astryx-svelte/theme-stone": "workspace:*",
		"@astryx-svelte/theme-y2k": "workspace:*",
		"@stylexjs/stylex": "^0.19.0"
	},
	"devDependencies": {
		"@astryxdesign/cli": "0.3.0",
		"@astryxdesign/core": "0.3.0",
		"@eslint/js": "^10.0.1",
		"@stylexjs/unplugin": "^0.19.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
