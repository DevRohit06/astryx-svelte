{
	"name": "@astryx-svelte/core",
	"displayName": "Astryx Core",
	"version": "0.3.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/devrohit06/astryx-svelte.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/devrohit06/astryx-svelte/issues"
	},
	"homepage": "https://github.com/devrohit06/astryx-svelte#readme",
	"publishConfig": {
		"access": "public"
	},
	"description": "Svelte 5 components for Astryx, Meta's open source design system.",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run prepack",
		"build:demo": "vite build",
		"preview": "npm run build:demo && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:client": "node scripts/run-client-tests.mjs",
		"test:parity": "node scripts/compare-upstream-classes.mjs",
		"test": "npm run test:unit -- --run --project=server && npm run test:client && npm run test:parity"
	},
	"files": [
		"dist",
		"src",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.spec.*",
		"!src/tests",
		"!src/routes",
		"!src/app.html"
	],
	"sideEffects": [
		"**/*.stylex.ts",
		"**/*.stylex.js",
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"svelte": "./dist/theme/index.js",
			"default": "./dist/theme/index.js"
		},
		"./theme/define": {
			"types": "./dist/theme/define/index.d.ts",
			"svelte": "./dist/theme/define/index.js",
			"default": "./dist/theme/define/index.js"
		},
		"./theme/syntax": {
			"types": "./dist/theme/syntax/index.d.ts",
			"svelte": "./dist/theme/syntax/index.js",
			"default": "./dist/theme/syntax/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"svelte": "./dist/hooks/index.js",
			"default": "./dist/hooks/index.js"
		},
		"./naming": {
			"types": "./dist/internal/naming.d.ts",
			"svelte": "./dist/internal/naming.js",
			"default": "./dist/internal/naming.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js",
			"default": "./dist/i18n/index.js"
		},
		"./locales/*.json": "./dist/locales/*.json",
		"./base.css": "./dist/styles/base.css"
	},
	"peerDependencies": {
		"@stylexjs/stylex": "^0.19.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@astryxdesign/core": "0.3.0",
		"@babel/core": "^7.29.7",
		"@babel/plugin-syntax-typescript": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@stylexjs/babel-plugin": "^0.19.0",
		"@stylexjs/stylex": "^0.19.0",
		"@stylexjs/unplugin": "^0.19.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.0.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"intl-messageformat": "^11.2.9"
	}
}
