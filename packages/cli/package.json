{
	"name": "@astryx-svelte/cli",
	"displayName": "CLI",
	"version": "0.4.2",
	"description": "Scaffold projects, browse templates, generate themes, and get agent-ready docs from the command line.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/devrohit06/astryx-svelte.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/devrohit06/astryx-svelte/issues"
	},
	"homepage": "https://github.com/devrohit06/astryx-svelte#readme",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"astryx-svelte": "./bin/astryx-svelte.mjs"
	},
	"exports": {
		".": "./bin/astryx-svelte.mjs",
		"./json": {
			"types": "./api/json/index.ts",
			"import": "./api/json/parse.mjs"
		},
		"./api": {
			"import": "./api/index.mjs"
		},
		"./authoring": {
			"types": "./authoring/index.d.ts",
			"import": "./authoring/index.mjs"
		},
		"./config": {
			"types": "./authoring/config/type.ts",
			"import": "./authoring/config/parse.mjs"
		},
		"./integration": {
			"types": "./authoring/integration/type.ts",
			"import": "./authoring/integration/parse.mjs"
		},
		"./doc": {
			"types": "./authoring/doctypes/types.ts",
			"import": "./authoring/doctypes/parse.mjs"
		},
		"./template": {
			"types": "./authoring/doctypes/types.ts",
			"import": "./authoring/doctypes/template/parse.mjs"
		},
		"./codemod": {
			"types": "./authoring/codemod/type.ts",
			"import": "./authoring/codemod/parse.mjs"
		},
		"./xle": {
			"types": "./foundation/xle/browser.d.ts",
			"import": "./foundation/xle/browser.mjs"
		}
	},
	"files": [
		"bin",
		"api",
		"assets",
		"authoring",
		"clients",
		"foundation",
		"!**/*.test.mjs"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"astryx-svelte": "node bin/astryx-svelte.mjs",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:core-src": "node scripts/assert-core-ships-src.mjs",
		"generate-themes": "node scripts/generate-cli-themes.mjs",
		"test:themes-bundle": "node scripts/generate-cli-themes.mjs --check",
		"test": "npm run test:unit -- --run && npm run test:core-src && npm run test:themes-bundle"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"jiti": "^2.7.0",
		"magic-string": "^0.30.21",
		"zimmerframe": "^1.1.4",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"@astryx-svelte/core": "*",
		"@astryx-svelte/theme-neutral": "*",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@astryx-svelte/core": {
			"optional": true
		},
		"@astryx-svelte/theme-neutral": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@astryx-svelte/core": "workspace:*",
		"@astryx-svelte/theme-neutral": "workspace:*",
		"@eslint/js": "^10.0.1",
		"@fvilers/heroicons-svelte": "2.1.5-fix.3",
		"@lucide/svelte": "^1.25.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.10"
	}
}
